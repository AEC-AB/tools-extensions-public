<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtensionId>DaluxCloudUpload</ExtensionId>
    <Authors>AEC AB</Authors>
    <Title>Dalux Cloud Upload</Title>
    <Description>Dalux Cloud Upload Extension</Description>
    <PackageTags>AssistantExtension;Assistant;Extension</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageIconUrl></PackageIconUrl>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
	<ItemGroup>
		<PackageReference Include="CW.Assistant.Extensions.Assistant" Version="26.*">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>compile</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="1.7.3" />
	</ItemGroup>
</Project>